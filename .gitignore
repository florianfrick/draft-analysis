# ============================================================
# Secrets - NEVER commit these (revoke/rotate if ever pushed)
# ============================================================
# Riot dev key (data/solo queue collection) + W&B key (training logs).
# Both are provided via env vars; see data/solo queue/riot_api.py and
# solo_queue/model/pretraining/train.py. Keep only .env.example in the repo.
.env
!.env.example
*.pem
*.key
wandb_key.txt
**/wandb_key.txt
*w_key.txt
*secret*
*token*
credentials*.json
secrets*.json

# ============================================================
# Model weights / checkpoints (100MB+ each, GitHub blocks >100MB)
# ============================================================
*.pt
*.pth
*.bin
*.onnx
*.ckpt
*.safetensors
# The kept artefacts: <track>/model/checkpoints/<name>/ - one directory per
# inference class, the name states what it can do (masking-* / nextpick-*).
# The track (`solo_queue/` or `pro/`) says which data trained it.
solo_queue/model/checkpoints/
pro/model/checkpoints/
**/ckpt/
# Per-run console logs and the "last run" scratch file. The evidence that is
# kept lives in pro/model/proonly/reports/ (test reports + paired comparisons).
pro/model/proonly/logs/
pro/model/proonly/last_*.json

# ============================================================
# Data (GBs of match records, derived caches, player ids)
# Raw + derived match data stays local; collectors rebuild it.
# ============================================================
data/solo queue/matchdata/
data/solo queue/matchids/
data/solo queue/puuids/
data/solo queue/process matchdata/drafts_*.pt
data/pro play/*.csv
data/pro play/*.pt
# Patch notes corpus: local only, deliberately not in the repo. It was removed
# in 8a30a07 and stays out - the measurement in STATUS.md §P3.1 says the
# input-side adapter cannot turn patch changes into a cold-start prior, which
# was the only thing the corpus was for. `frontend/llm.py` reads it when it is
# present (patch-grounded explanations) and degrades cleanly when it is not.
data/patch notes/
*.jsonl
*.jsonl.gz
matchids/
puuids/
matchdata/

# ============================================================
# Analytical store (derived, ~800MB, rebuilt by `store.py build`)
# ============================================================
solo_queue/analysis/store/
**/*.duckdb
**/*.duckdb.wal
**/*.parquet

# ============================================================
# Logs / run outputs / caches (machine-specific, noisy)
# ============================================================
wandb/
**/wandb/
# Every trainer passes `dir=<its own model folder>/wandb_runs` to wandb.init, so
# runs land beside the code. Never name that folder `wandb`: it would shadow the
# installed package on sys.path and `wandb.init` would silently not exist.
wandb_runs/
**/wandb_runs/
frontend/server.log
frontend/server.err
frontend/.cache/
*.log
*.err
__pycache__/
*.pyc
# a local venv per model folder (pro/model/llm/.venv is ~330MB)
.venv/
**/.venv/
.pytest_cache/
.ipynb_checkpoints/
last_run.json
**/last_run.json
evaluate_report.json
**/evaluate_report.json
.DS_Store
Thumbs.db
.vscode/
.idea/
.workbuddy-ai/
*.corrupt
solo_queue/analysis/additive_model.json
