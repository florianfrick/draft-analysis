# Copy to .env and fill in (NEVER commit .env or any real key).
# Riot dev key: https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=
# Weights & Biases (training logs): https://wandb.ai/authorize
WANDB_API_KEY=
# Agent LLM (OPTIONAL). The board and role board need no key. Any
# OpenAI-compatible endpoint works, including the existing Cloudflare Worker.
# These values stay on the SERVER: the browser never sees LLM_API_KEY.
#
# Local/direct DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-flash
#   LLM_API_KEY=<DeepSeek key>
#
# Hosted webapp (recommended): same Worker as the Android app, OpenAI route.
# Set WEBAPP_LLM_TOKEN as a Cloudflare secret, then use that value here.
# The Worker keeps the DeepSeek key and counts one agent turn per request.
#   LLM_BASE_URL=https://draft-assistant-chat.floriangfrick.workers.dev/v1
#   LLM_MODEL=deepseek-flash
#   LLM_API_KEY=<WEBAPP_LLM_TOKEN>
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# LLM_TIMEOUT=60

