# Copy to .env and fill in (NEVER commit .env or any real key).
# Riot dev key: https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=
# Weights & Biases (training logs): https://wandb.ai/authorize
WANDB_API_KEY=
# LLM for /api/explain (optional - without a key the endpoint still returns
# retrieved evidence, just no prose). Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

