# Copy to .env and fill in (NEVER commit .env or any real key).
# Riot dev key: https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=
# Weights & Biases (training logs): https://wandb.ai/authorize
WANDB_API_KEY=
# LLM for /api/explain (OPTIONAL, and not needed by the button). The panel's
# explanation is composed locally from the loaded model's own numbers; these
# only matter if you call `llm.explain(client=client_from_env())` yourself, or
# want the hosted path back. Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

