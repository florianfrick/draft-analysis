<?xml version="1.0" encoding="utf-8"?>
<!--
  Local-only MVP talks to the backend over plain HTTP. Cleartext is enabled
  for the loopback aliases only, so a stray https:// link still gets the
  platform default. Add your machine's LAN address here if you run on a
  physical device.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
