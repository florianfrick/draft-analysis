# Keep the build context small. The dev Dockerfile mounts code/data at run
# time; Dockerfile.web copies a short explicit allow-list instead. Patterns
# below trim the 9GB of checkpoints/CSVs we never want to send to the daemon,
# with narrow re-includes for the two shipped checkpoints and the caches the
# slim web image needs.

# --- data: only tiny tables + the walkthrough cache are kept ----------------
data/solo queue/matchdata/
data/solo queue/process matchdata/*
!data/solo queue/process matchdata/champ_mapping.json
!data/solo queue/process matchdata/champ_names.json
data/pro play/*
data/solo queue/analysis/store/
**/*.parquet
**/*.duckdb
**/*.duckdb.wal
**/*.csv
**/*.csv.gz
**/*.jsonl
**/*.jsonl.gz

# --- checkpoints / weights --------------------------------------------------
# Exclude everything, then re-include exactly what Dockerfile.web COPYs.
**/*.pt
**/*.pth
**/*.ckpt
**/*.bin
**/*.safetensors
**/*.onnx

# --- directories the web image never imports --------------------------------
pro/model/archive/
pro/model/bans/
pro/model/naivetransformer/
pro/model/test_split/
pro/model/checkpoints/*
solo_queue/analysis/
solo_queue/data/
solo_queue/model/checkpoints/
solo_queue/model/finetune/ckpt/
solo_queue/model/tests/
webapp/uploaded/
webapp/.pytest_cache/

# --- run outputs ------------------------------------------------------------
**/wandb/
**/wandb_runs/
**/*.log
**/*.err
**/last_run.json
**/test_report.json
**/eval_protocol.json

# --- vcs / editor / agent state --------------------------------------------
.git/
.gitignore
.workbuddy-ai/
.vscode/
.idea/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# --- secrets ---------------------------------------------------------------
.env
# terraform.tfvars holds the Worker bearer token; never send it to the daemon.
deploy/
**/*.tfvars
*w_key.txt
*wandb_key.txt

# --- docker's own files ----------------------------------------------------
Dockerfile
docker-compose.yml
.dockerignore
DOCKER.md

# --- narrow re-includes (LAST wins in Docker's ignore rules) ---------------
# The walkthrough cache and exactly two shipped checkpoints. All other .pt
# files stay excluded, including the 40+ MB pro_drafts_all.pt.
!data/pro play/pro_drafts_full.pt
!pro/model/checkpoints/masking-proonly-nov13-through-lcp-df-sw/
!pro/model/checkpoints/masking-proonly-nov13-through-lcp-df-sw/best.pt
!pro/model/checkpoints/nextpick-proonly-nov13-k5-through-lcp-df-sw/
!pro/model/checkpoints/nextpick-proonly-nov13-k5-through-lcp-df-sw/best.pt
